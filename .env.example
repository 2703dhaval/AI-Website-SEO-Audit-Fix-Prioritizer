# Database Configuration
# Local SQLite default: sqlite:///./seo_audit.db
# Production PostgreSQL example: postgresql://user:password@localhost:5432/seo_audit_pro
DATABASE_URL=sqlite:///./seo_audit.db

# Frontend and Backend URLs
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Web Crawler Politeness & Safety Limits
CRAWLER_USER_AGENT=SEOAuditProBot/1.0 (+https://scalezix.com/bot; technical-audit)
MAX_CRAWL_PAGES=50
DEFAULT_CRAWL_PAGES=25
MAX_CRAWL_DEPTH=5
DEFAULT_CRAWL_DEPTH=3
REQUEST_TIMEOUT_SECONDS=10.0
REQUEST_DELAY_SECONDS=0.5
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5

# SSRF Network Security Controls
# In production, keep ALLOW_LOCAL_TEST_DOMAINS=false to strictly reject loopback/private IPs
ALLOW_LOCAL_TEST_DOMAINS=false

# Optional AI / LLM Integration (System works 100% deterministically without API keys)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
